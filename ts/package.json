{
  "name": "lean-interact",
  "version": "0.11.6",
  "description": "TypeScript port of LeanInteract: interact with the Lean 4 theorem prover through the Lean REPL.",
  "keywords": [
    "Lean",
    "theorem proving",
    "autoformalization",
    "REPL"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivigasin/lean-interact.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/ivigasin/lean-interact/tree/main/ts#readme",
  "bugs": {
    "url": "https://github.com/ivigasin/lean-interact/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lean-interact": "./dist/cli.js",
    "install-lean": "./dist/cli.js",
    "clear-lean-cache": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "test:e2e": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs --e2e",
    "clean": "rm -rf dist build-test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
